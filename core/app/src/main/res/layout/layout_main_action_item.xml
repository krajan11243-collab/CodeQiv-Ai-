<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary Home action row (More options). Quiet surface row so the primary
  grid tiles stand out. Shares the actionButton ID with the grid tile layout. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/actionButton"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="0dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:textAlignment="textStart"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:cornerRadius="12dp"
        app:iconPadding="12dp"
        app:iconSize="20dp"
        app:iconTint="?attr/colorOnSurfaceVariant"
        app:rippleColor="?attr/colorSecondaryContainer"
        tools:icon="@drawable/ic_settings"
        tools:text="@string/msg_preferences" />

</com.google.android.material.card.MaterialCardView>
