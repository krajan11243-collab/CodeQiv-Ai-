<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/coordinator"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:background="#05070D"
  app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <TextView
      android:id="@+id/brandTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="CodeQiv"
      android:textColor="#F7F8FF"
      android:textSize="34sp"
      android:fontFamily="sans"
      android:textStyle="bold"
      android:letterSpacing="-0.025"
      android:gravity="center" />

    <TextView
      android:id="@+id/brandTagline"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="Your Ideas, Anywhere"
      android:textColor="#AAB5D0"
      android:textSize="14sp"
      android:letterSpacing="0.04"
      android:gravity="center" />

    <com.google.android.material.imageview.ShapeableImageView
      android:id="@+id/main_image"
      android:layout_width="132dp"
      android:layout_height="132dp"
      android:layout_marginTop="20dp"
      android:layout_marginBottom="10dp"
      android:src="@drawable/ic_acs"
      android:contentDescription="CodeQiv FFX logo"
      app:shapeAppearance="@style/AppTheme.ShapeAppearance.MainFragment.Logo" />

    <TextView
      android:id="@+id/getStarted"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/get_started"
      android:layout_marginTop="0dp"
      android:textColor="#F7F8FF"
      android:textSize="25sp"
      android:textStyle="bold"
      android:gravity="center" />

    <TextView
      android:id="@+id/greetingText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:layout_marginBottom="14dp"
      android:text="@string/msg_create_new_project_greeting"
      android:textColor="#AAB5D0"
      android:textSize="14sp"
      android:gravity="center" />

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/actions"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:clipToPadding="false"
      android:overScrollMode="never"
      android:nestedScrollingEnabled="false"
      android:layout_marginTop="2dp"
      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
      tools:listitem="@layout/layout_main_action_item" />

  </LinearLayout>
</androidx.core.widget.NestedScrollView>
