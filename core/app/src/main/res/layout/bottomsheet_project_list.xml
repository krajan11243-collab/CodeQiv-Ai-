<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="20dp"
  android:paddingTop="12dp"
  android:paddingBottom="24dp">

  <!-- Header: title + subtitle + explicit close -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingBottom="4dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/projects_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/projects_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnCloseProjects"
      style="@style/Widget.Material3.Button.IconButton"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:contentDescription="@string/projects_close"
      app:icon="@drawable/ic_close"
      app:iconTint="?attr/colorOnSurfaceVariant" />

  </LinearLayout>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/searchLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:hint="@string/search_projects_hint"
    app:startIconDrawable="@drawable/ic_search"
    app:endIconMode="clear_text"
    app:boxBackgroundMode="filled"
    style="@style/Widget.Material3.TextInputLayout.FilledBox">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/searchEditText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="text"
      android:imeOptions="actionSearch"
      android:maxLines="1" />

  </com.google.android.material.textfield.TextInputLayout>

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/projectsRecyclerView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="400dp"
    android:scrollbars="vertical" />

  <TextView
    android:id="@+id/emptyText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/no_projects_found"
    android:textAlignment="center"
    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant"
    android:padding="32dp"
    android:visibility="gone"
    tools:visibility="visible" />

  <!-- Secondary browse action, full width for easy discovery -->
  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnBrowse"
    style="@style/Widget.Material3.Button.OutlinedButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:minHeight="48dp"
    android:contentDescription="@string/browse_other_location"
    app:icon="@drawable/ic_folder"
    android:text="@string/browse"
    app:iconGravity="textStart"
    app:iconPadding="12dp" />

</LinearLayout>
