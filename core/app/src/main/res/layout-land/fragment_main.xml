<!-- Landscape: header on the left, actions scroll on the right. IDs match layout/fragment_main.xml. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/coordinator"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:baselineAligned="false"
  android:orientation="horizontal">

  <!-- Header (IDs kept for MainFragment compat) -->
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.imageview.ShapeableImageView
      android:id="@+id/main_image"
      android:layout_width="72dp"
      android:layout_height="72dp"
      android:contentDescription="@string/app_name"
      android:src="@drawable/ic_acs"
      app:shapeAppearance="@style/AppTheme.ShapeAppearance.MainFragment.Logo" />

    <TextView
      android:id="@+id/getStarted"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/get_started"
      android:textAlignment="center"
      android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/greetingText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="@string/msg_create_new_project_greeting"
      android:textAlignment="center"
      android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
      android:textColor="?attr/colorOnSurfaceVariant" />

  </LinearLayout>

  <androidx.core.widget.NestedScrollView
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="16dp"
      android:paddingTop="16dp"
      android:paddingBottom="24dp">

      <!-- Primary call to action -->
      <com.google.android.material.button.MaterialButton
        android:id="@+id/actionCreateProject"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/new_project"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="12dp" />

      <!-- Primary actions grid: Open + Clone side by side, Terminal full width.
        LayoutManager is set in code (GridLayoutManager with span lookup). -->
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:nestedScrollingEnabled="false"
        tools:listitem="@layout/layout_main_action_grid_item" />

      <!-- Recent projects (hidden when empty) -->
      <LinearLayout
        android:id="@+id/recentSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_recent_projects"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewAllProjects"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/home_view_all" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recentList"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:nestedScrollingEnabled="false"
          app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
          tools:listitem="@layout/item_project" />

      </LinearLayout>

      <!-- Secondary actions: Preferences / IDE config / Docs -->
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_more_options"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/moreActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/layout_main_action_item" />

    </LinearLayout>

  </androidx.core.widget.NestedScrollView>

</LinearLayout>
